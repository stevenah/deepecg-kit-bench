layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%}
Hand-written because jekyll-sitemap's template is not strict_variables-safe. Fifteen lines
we control beats a plugin whose key set we do not.
{%- endcomment -%}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.html_pages | where_exp: "p", "p.url != '/404.html'" -%}
{%- for p in pages %}
  <url><loc>{{ p.url | absolute_url }}</loc></url>
{%- endfor %}
{%- for d in site.models %}
  <url><loc>{{ d.url | absolute_url }}</loc></url>
{%- endfor %}
{%- for d in site.tasks %}
  <url><loc>{{ d.url | absolute_url }}</loc></url>
{%- endfor %}
{%- for d in site.snapshots %}
  <url><loc>{{ d.url | absolute_url }}</loc></url>
{%- endfor %}
</urlset>
